# ---------------------------------------------------------------------------
# Duval County property intelligence UI
#
# Every variable is NEXT_PUBLIC_*, which means it is inlined into the browser
# bundle at build time and is visible to anyone who opens the page. That is
# correct here: all of these are public, content addressed artifact URLs. There
# is no secret in this application, and there must never be one, because the UI
# talks to IPFS gateways directly with no server in between.
#
# Any variable left unset falls back to the synthetic files in public/sample and
# the app labels itself SAMPLE in the header and on every affected panel.
#
# On Vercel: set these in Project Settings -> Environment Variables, then
# redeploy. NEXT_PUBLIC_* values are baked into the build, so changing one
# requires a new deployment, not just a restart.
# ---------------------------------------------------------------------------

# The published query table. Either the IPNS directory root, in which case the
# app appends /query-table.parquet, or a direct URL to the parquet object.
# Must be served with permissive CORS and HTTP range support.
NEXT_PUBLIC_QUERY_TABLE_URL=https://ipfs.filebase.io/ipns/k51...

# run-history.json: runs, per source record counts and deltas, limitations,
# and the artifact CIDs / IPNS names each run published.
NEXT_PUBLIC_RUN_HISTORY_URL=https://ipfs.filebase.io/ipns/k51.../run-history.json

# dataset-coverage.json: ingested against expected per source.
NEXT_PUBLIC_COVERAGE_URL=https://ipfs.filebase.io/ipns/k51.../dataset-coverage.json

# published-counties catalog.json: which counties are published and where.
NEXT_PUBLIC_CATALOG_URL=https://ipfs.filebase.io/ipns/k51.../catalog.json

# Optional. The sharded per property JSON index, used by the property detail
# drawer to link and render the consolidated record.
NEXT_PUBLIC_OPEN_DATA_INDEX_URL=https://ipfs.filebase.io/ipns/k51.../index.json

# Optional. Base URL of the deployed MCP server. The /mcp page renders real
# connection snippets when this is set, and a placeholder when it is not.
NEXT_PUBLIC_MCP_URL=https://your-mcp-deployment.vercel.app

# Optional. County identity, used for labels and for the MCP env map keys.
NEXT_PUBLIC_COUNTY_KEY=duval
NEXT_PUBLIC_COUNTY_NAME=Duval
NEXT_PUBLIC_STATE_CODE=FL
