# ---------------------------------------------------------------------------
# Duval County property intelligence UI
#
# There are two kinds of variable in this file, and the difference matters.
#
# 1. NEXT_PUBLIC_* is inlined into the browser bundle at build time and is
#    visible to anyone who opens the page. That is correct for all of them:
#    they are public, content addressed artifact URLs, and the data pages talk
#    to IPFS gateways directly with no server in between.
#
# 2. Everything under "Server side" below is NOT public. This file used to say
#    the application has no secret and must never have one. That was true when
#    every page ran in the browser, and it stopped being true when /api/agent
#    landed: that route runs on the server and can hold a model provider API
#    key. The statement is corrected rather than left standing, because a
#    comment that contradicts the code is worse than no comment.
#
# Any NEXT_PUBLIC_* left unset falls back to the synthetic files in
# public/sample and the app labels itself SAMPLE in the header and on every
# affected panel.
#
# On Vercel: set these in Project Settings -> Environment Variables, then
# redeploy. NEXT_PUBLIC_* values are baked into the build, so changing one
# requires a new deployment, not just a restart.
# ---------------------------------------------------------------------------

# The published query table. A URL ending in "/" is treated as a directory and
# /query-table.parquet is appended; anything else is used exactly as given.
# This pipeline points each IPNS name at one file's CID, so the value here is
# normally the bare name with NO trailing slash.
# Must be served with permissive CORS and HTTP range support.
NEXT_PUBLIC_QUERY_TABLE_URL=https://ipfs.filebase.io/ipns/k51...

# run-history.json: runs, per source record counts and deltas, limitations,
# and the artifact CIDs / IPNS names each run published.
NEXT_PUBLIC_RUN_HISTORY_URL=https://ipfs.filebase.io/ipns/k51.../run-history.json

# dataset-coverage.json: ingested against expected per source.
NEXT_PUBLIC_COVERAGE_URL=https://ipfs.filebase.io/ipns/k51.../dataset-coverage.json

# published-counties catalog.json: which counties are published and where.
NEXT_PUBLIC_CATALOG_URL=https://ipfs.filebase.io/ipns/k51.../catalog.json

# Optional. The sharded per property JSON index, used by the property detail
# drawer to link and render the consolidated record.
NEXT_PUBLIC_OPEN_DATA_INDEX_URL=https://ipfs.filebase.io/ipns/k51.../index.json

# Optional. Base URL of the deployed MCP server. The /mcp page renders real
# connection snippets when this is set, and a placeholder when it is not.
NEXT_PUBLIC_MCP_URL=https://your-mcp-deployment.vercel.app

# Optional. County identity, used for labels and for the MCP env map keys.
NEXT_PUBLIC_COUNTY_KEY=duval
NEXT_PUBLIC_COUNTY_NAME=Duval
NEXT_PUBLIC_STATE_CODE=FL


# ---------------------------------------------------------------------------
# Server side. Read by /api/agent only. Never inlined into the browser bundle.
# ---------------------------------------------------------------------------

# The same artifacts, read by the server side DuckDB the agent tools query.
# Without these the agent answers from public/sample and says so.
QUERY_TABLE_URL=https://ipfs.filebase.io/ipns/k51.../query-table.parquet
RUN_HISTORY_URL=https://ipfs.filebase.io/ipns/k51.../run-history.json


# --- Model provider ---------------------------------------------------------
#
# THIS DEPLOYMENT SETS EXACTLY ONE OF THE KEYS BELOW: OPENROUTER_API_KEY, on
# Vercel, never in this repository. It points at OpenRouter :free models, which
# cost $0.00 per token, so a visitor who configures nothing still gets a real
# answer and no budget is at risk. That is the only reason a server side key is
# acceptable on a public, unauthenticated route: a paid key here would be a bill
# any stranger could run up.
#
# Visitors can still bring their own key on the /settings page. It is stored in
# their browser, travels per request in the x-llm-api-key header, and always
# beats the server default.
#
# With no key configured anywhere the route returns 501 with a typed body
# saying so, and the Questions page still answers every question with no model
# at all. The provider registry in lib/agent/providers.ts is the source of truth
# for what is supported; the settings UI and the server both read it, so they
# cannot disagree.

# Optional. One of: openrouter, google, groq, cerebras, huggingface,
# vercel-ai-gateway, anthropic, bedrock.
# When unset, the first provider below that has a key present wins, in registry
# order. Naming a provider here without giving it a key is treated as a
# misconfiguration: the route reports "not configured" rather than quietly
# falling through to a different provider's key.
# AGENT_PROVIDER=google

# Optional. Must be a model the registry lists for the selected provider, for
# example gemini-3.7-flash, openai/gpt-oss-120b or claude-opus-5. An id
# belonging to a different provider is ignored and the provider's default free
# model is used instead.
# AGENT_MODEL=gemini-3.7-flash

# OpenRouter. THIS IS THE SERVER DEFAULT and the only key this deployment sets.
# Its :free model variants cost $0.00 per token and are open weight (Nemotron,
# GPT-OSS, GLM, Gemma). Capped at 50 requests a day, which is roughly 12
# questions here, or 1,000 a day (roughly 250 questions) once $10 of credits has
# ever been bought. The :free models stay $0.00 either way; the $10 only lifts
# the cap.
# Two caveats, both handled in code but worth knowing:
#  - Free models route only to providers that may train on the prompt, so
#    prompt training has to be on at https://openrouter.ai/settings/privacy or
#    every call fails with "No endpoints found matching your data policy".
#  - Free models draw on a shared pool that returns 429 without warning. Every
#    :free request is therefore sent with two alternates in a `models` array
#    (OpenRouter caps that array at three entries) and it reroutes by itself.
# Key: https://openrouter.ai/settings/keys
# OPENROUTER_API_KEY=sk-or-v1-...

# Google AI Studio (Gemini). Free tier, no card required as of 2026-08-21.
# Key: https://aistudio.google.com/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=AIza...

# Groq. The free tier is measurably too small for this agent: it allows 8,000
# tokens/min and one mid-conversation request here is about 8,300 (measured in
# tests/agent-prompt-budget.test.ts). Fine on a paid Groq tier.
# Key: https://console.groq.com/keys
# GROQ_API_KEY=gsk_...

# Cerebras. $5 of one time signup credit, not a recurring allowance.
# Key: https://cloud.cerebras.ai
# CEREBRAS_API_KEY=csk-...

# Hugging Face. $0.10 of routed inference credit a month on a free account, no
# card, refreshing monthly. One token reaches around 130 models across many
# inference providers. Nothing on the router is priced at zero, so the credit is
# the entire free tier: roughly 60 questions on gpt-oss-120b.
# Key: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_...

# Vercel AI Gateway. One key reaches many models. The monthly free credit only
# covers a subset of the catalog; see lib/agent/providers.ts for the caveat.
# Key: Vercel dashboard -> AI Gateway
# AI_GATEWAY_API_KEY=vck_...

# Anthropic. No free tier. This is the quality option: claude-opus-5.
# Key: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Amazon Bedrock. Either a bearer token, or an access key pair for SigV4.
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1


# --- Abuse controls ---------------------------------------------------------
#
# Per client address, counted in process. Vercel runs several instances, so the
# real cap is per instance rather than global; see lib/agent/ratelimit.ts for
# why this app does not add a datastore to fix that.

# Questions per window on /api/agent. Default 15.
# AGENT_RATE_LIMIT=15
# Window length in milliseconds. Default 600000 (10 minutes).
# AGENT_RATE_WINDOW_MS=600000

# Credential tests per window on /api/agent/test. Default 10.
# AGENT_TEST_RATE_LIMIT=10
# Window length in milliseconds. Default 60000 (1 minute).
# AGENT_TEST_RATE_WINDOW_MS=60000


# --- Logging ----------------------------------------------------------------
#
# One JSON line per agent event on stdout. Set to "off" to silence it. Log
# lines never contain key material: every message on the request path goes
# through lib/agent/redact.ts first, and the key itself is only ever logged as
# a non reversible fingerprint. tests/agent-secrets.test.ts enforces both.
# AGENT_LOG=off
