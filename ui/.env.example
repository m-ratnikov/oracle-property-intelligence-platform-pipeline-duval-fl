# ---------------------------------------------------------------------------
# Duval County property intelligence UI
#
# There are two kinds of variable in this file, and the difference matters.
#
# 1. NEXT_PUBLIC_* is inlined into the browser bundle at build time and is
#    visible to anyone who opens the page. That is correct for all of them:
#    they are public, content addressed artifact URLs, and the data pages talk
#    to IPFS gateways directly with no server in between.
#
# 2. Everything under "Server side" below is NOT public. This file used to say
#    the application has no secret and must never have one. That was true when
#    every page ran in the browser, and it stopped being true when /api/agent
#    landed: that route runs on the server and can hold a model provider API
#    key. The statement is corrected rather than left standing, because a
#    comment that contradicts the code is worse than no comment.
#
# Any NEXT_PUBLIC_* left unset falls back to the synthetic files in
# public/sample and the app labels itself SAMPLE in the header and on every
# affected panel.
#
# On Vercel: set these in Project Settings -> Environment Variables, then
# redeploy. NEXT_PUBLIC_* values are baked into the build, so changing one
# requires a new deployment, not just a restart.
# ---------------------------------------------------------------------------

# The published query table. A URL ending in "/" is treated as a directory and
# /query-table.parquet is appended; anything else is used exactly as given.
# This pipeline points each IPNS name at one file's CID, so the value here is
# normally the bare name with NO trailing slash.
# Must be served with permissive CORS and HTTP range support.
NEXT_PUBLIC_QUERY_TABLE_URL=https://ipfs.filebase.io/ipns/k51...   # oracle-query-table-duval

# run-history.json: runs, per source record counts and deltas, limitations,
# and the artifact CIDs / IPNS names each run published. Use the IPNS NAME, not
# a CID: a CID freezes this page at whichever run published it, and this is the
# page that shows ingestion is continuous. The gateway caches an IPNS lookup for
# 300 s, well inside the six hour publish cadence.
NEXT_PUBLIC_RUN_HISTORY_URL=https://ipfs.filebase.io/ipns/k51...   # oracle-run-history-duval

# dataset-coverage.json: ingested against expected per source.
NEXT_PUBLIC_COVERAGE_URL=https://ipfs.filebase.io/ipns/k51...   # oracle-dataset-coverage-duval

# published-counties catalog.json: which counties are published and where.
NEXT_PUBLIC_CATALOG_URL=https://ipfs.filebase.io/ipns/k51...   # oracle-published-counties

# Optional. The sharded per property JSON index, used by the property detail
# drawer to link and render the consolidated record.
NEXT_PUBLIC_OPEN_DATA_INDEX_URL=https://ipfs.filebase.io/ipns/k51.../index.json

# Optional. artifacts/<county>/index.json: every object the publish step uploaded,
# with the gateway URL it uploaded it to and the IPNS name it pointed at it. The
# artifact cards on / and /runs join the run history to this, because a run record
# carries only a CID. Unset, those cards say "not available" for the gateway URL
# and the IPNS name, which is what they said before this variable existed. It is
# deliberately NOT one of the four artifacts that flip the runtime to SAMPLE, so
# leaving it unset does not brand a real deployment synthetic. Use the IPNS NAME:
# the index is republished on every publish.
NEXT_PUBLIC_ARTIFACTS_INDEX_URL=https://ipfs.filebase.io/ipns/k51...   # duval-oracle-artifacts

# Optional. Base URL of the deployed MCP server. The /mcp page renders real
# connection snippets when this is set, and a placeholder when it is not.
NEXT_PUBLIC_MCP_URL=https://your-mcp-deployment.vercel.app

# Optional. County identity, used for labels and for the MCP env map keys.
NEXT_PUBLIC_COUNTY_KEY=duval
NEXT_PUBLIC_COUNTY_NAME=Duval
NEXT_PUBLIC_STATE_CODE=FL

# Optional. The IPFS gateway used to build a URL for a bare CID, in the two
# places that hold a CID rather than a full URL: the property document links in
# lib/openData.ts and the artifact links in lib/types.ts. Every other artifact
# above carries its own complete URL and ignores this. Trailing slashes are
# stripped. Defaults to https://ipfs.filebase.io, which is the gateway this
# pipeline publishes to; point it elsewhere only if you are pinning elsewhere.
# NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.filebase.io


# ---------------------------------------------------------------------------
# Server side. Read by /api/agent only. Never inlined into the browser bundle.
# ---------------------------------------------------------------------------

# The same artifacts, read by the server side DuckDB the agent tools query.
# Without these the agent answers from public/sample and says so. Each falls
# back to its NEXT_PUBLIC_* twin when unset, so a deployment that has set the
# browser side variables does not have to repeat them here; set these only when
# the server should read a different copy from the browser.
QUERY_TABLE_URL=https://ipfs.filebase.io/ipns/k51.../query-table.parquet
RUN_HISTORY_URL=https://ipfs.filebase.io/ipns/k51.../run-history.json

# Optional. The sharded per property JSON index, read by the agent's
# get_property tool. Same fallback rule: unset, it uses
# NEXT_PUBLIC_OPEN_DATA_INDEX_URL.
# OPEN_DATA_INDEX_URL=https://ipfs.filebase.io/ipns/k51.../index.json


# --- Model provider ---------------------------------------------------------
#
# THIS DEPLOYMENT SETS EXACTLY ONE OF THE KEYS BELOW, on Vercel, never in this
# repository. Which one is a deployment decision, and it changes what has to be
# true about spending.
#
# This file used to say the only acceptable server key on a public route was a
# free one, and that a paid key "would be a bill any stranger could run up".
# The first half was too strong and the second half was correct as written, so
# the rule is restated rather than deleted: a paid key IS acceptable here, and
# only once the bill it can run up is a number somebody chose.
#
# THE RULE, in the order the controls actually bind:
#
#  1. Set a hard spend cap ON THE KEY, at the provider. An OpenAI project
#     budget limit, an OpenRouter per key credit limit, an Anthropic workspace
#     limit. This is the only ceiling that a recycled serverless instance
#     cannot reset, and it is enforced by the party holding the money, so it is
#     the real one. Nothing in this codebase can set it or verify it.
#  2. Record that number in AGENT_SPEND_CEILING_USD below, so the route can
#     report what protection exists instead of implying one that does not.
#  3. Leave the app side ceilings at their defaults unless you have a reason.
#     They are described under "Abuse and spend controls" further down.
#
# FAILING TO DO STEP 1 IS NOT SILENT. When the server credential resolves to a
# model the registry marks as billed and AGENT_SPEND_CEILING_USD is unset, the
# route clamps its global ceiling to 100 questions a day for everybody together
# and GET /api/agent reports `spend_ceiling.provider_side.clamped: true` with
# the reason. The demo keeps working; it just will not keep working at scale
# for an attacker.
#
# Visitors can still bring their own key on the /settings page. It is stored in
# their browser, travels per request in the x-llm-api-key header, always beats
# the server default, and is NOT counted against the global ceiling, because a
# caller spending their own money is not the thing being protected against.
#
# With no key configured anywhere the route returns 501 with a typed body
# saying so, and the Questions page still answers every question with no model
# at all. The provider registry in lib/agent/providers.ts is the source of truth
# for what is supported; the settings UI and the server both read it, so they
# cannot disagree.

# Optional. One of: openai, openrouter, google, groq, cerebras, huggingface,
# vercel-ai-gateway, anthropic, bedrock.
# When unset, the first provider below that has a key present wins, in registry
# order. Naming a provider here without giving it a key is treated as a
# misconfiguration: the route reports "not configured" rather than quietly
# falling through to a different provider's key.
# AGENT_PROVIDER=google

# Optional. Must be a model the registry lists for the selected provider, for
# example gemini-3.7-flash, openai/gpt-oss-120b or claude-opus-5. An id
# belonging to a different provider is ignored and the provider's default free
# model is used instead.
# AGENT_MODEL=gemini-3.7-flash

# Optional. A comma separated subset of the registry's models for the selected
# provider. This is what the model dropdown offers a visitor who has no key of
# their own, and the server refuses anything outside it, so a hand written
# x-llm-model header cannot point a billed key at the most expensive model in
# the catalogue. Unset, the dropdown offers every model the registry lists for
# the provider. Narrow it when the cheapest and the dearest model on a provider
# differ by more than you want a stranger choosing.
# AGENT_MODEL_CHOICES=gpt-5-mini,gpt-4.1-mini

# OpenAI. No free tier: every token is billed against prepaid credit, which is
# exactly the case the spend rule at the top of this section exists for. Set a
# project budget limit at
# https://platform.openai.com/settings/organization/limits before deploying
# this key, and record it in AGENT_SPEND_CEILING_USD.
# Key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-...

# OpenRouter. The zero cost option.
# Its :free model variants cost $0.00 per token and are open weight (Nemotron,
# GPT-OSS, GLM, Gemma). Capped at 50 requests a day, which is roughly 12
# questions here, or 1,000 a day (roughly 250 questions) once $10 of credits has
# ever been bought. The :free models stay $0.00 either way; the $10 only lifts
# the cap.
# Two caveats, both handled in code but worth knowing:
#  - Free models route only to providers that may train on the prompt, so
#    prompt training has to be on at https://openrouter.ai/settings/privacy or
#    every call fails with "No endpoints found matching your data policy".
#  - Free models draw on a shared pool that returns 429 without warning. Every
#    :free request is therefore sent with two alternates in a `models` array
#    (OpenRouter caps that array at three entries) and it reroutes by itself.
# Key: https://openrouter.ai/settings/keys
# OPENROUTER_API_KEY=sk-or-v1-...

# Google AI Studio (Gemini). Free tier, no card required as of 2026-08-21.
# Key: https://aistudio.google.com/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=AIza...
# Accepted as an alias, for an environment that already carries this name.
# GOOGLE_API_KEY=AIza...

# Groq. The free tier is measurably too small for this agent: it allows 8,000
# tokens/min and one mid-conversation request here is about 8,300 (measured in
# tests/agent-prompt-budget.test.ts). Fine on a paid Groq tier.
# Key: https://console.groq.com/keys
# GROQ_API_KEY=gsk_...

# Cerebras. $5 of one time signup credit, not a recurring allowance.
# Key: https://cloud.cerebras.ai
# CEREBRAS_API_KEY=csk-...

# Hugging Face. $0.10 of routed inference credit a month on a free account, no
# card, refreshing monthly. One token reaches around 130 models across many
# inference providers. Nothing on the router is priced at zero, so the credit is
# the entire free tier: roughly 60 questions on gpt-oss-120b.
# Key: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_...
# Accepted as an alias, for an environment that already carries this name.
# HUGGINGFACE_API_KEY=hf_...

# Vercel AI Gateway. One key reaches many models. The monthly free credit only
# covers a subset of the catalog; see lib/agent/providers.ts for the caveat.
# Key: Vercel dashboard -> AI Gateway
# AI_GATEWAY_API_KEY=vck_...

# Anthropic. No free tier. This is the quality option: claude-opus-5.
# Key: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Amazon Bedrock. Either a bearer token, or an access key pair for SigV4.
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1


# --- Abuse and spend controls ------------------------------------------------
#
# /api/agent is public and unauthenticated on purpose: a reviewer must be able
# to drive the demo with no credentials, and that is worth keeping. The cost of
# keeping it is that "what can a stranger spend" has to have an answer, and the
# answer is three ceilings rather than a login. All of them are in
# lib/agent/ratelimit.ts, with the reasoning and the honest limitations.
#
# Everything here is counted IN PROCESS. Vercel runs several instances and
# recycles them, so what is enforced is per instance per window. The global
# ceiling below deals with that by dividing the declared number by an assumed
# instance count, which is an approximation and is labelled as one in
# GET /api/agent. The ceiling that survives instance churn is the provider side
# spend cap, which is why AGENT_SPEND_CEILING_USD exists and why the model
# provider section above treats setting it as step one rather than an extra.

# CEILING 1: per client address. Questions per window on /api/agent.
# Bounds one caller. Bounds nobody with a proxy list. Default 15.
# AGENT_RATE_LIMIT=15
# Window length in milliseconds. Default 600000 (10 minutes).
# AGENT_RATE_WINDOW_MS=600000

# Credential tests per window on /api/agent/test. Default 10. Not counted
# against the global ceiling: that route refuses to run without a caller
# supplied key, so it never spends this deployment's money.
# AGENT_TEST_RATE_LIMIT=10
# Window length in milliseconds. Default 60000 (1 minute).
# AGENT_TEST_RATE_WINDOW_MS=60000

# CEILING 2: global. One budget shared by every caller who does NOT bring their
# own key, so the cost of this route stops scaling with the number of source
# addresses an attacker can rent. This is the control that turns the worst case
# from unbounded into a number.
#
# Questions per window across every visitor. Default 200, and clamped to 100
# when the server credential is billed and AGENT_SPEND_CEILING_USD is unset.
# AGENT_GLOBAL_LIMIT=200
# Window length in milliseconds. Default 86400000 (24 hours).
# AGENT_GLOBAL_WINDOW_MS=86400000
# Warm instances the ceiling is divided across, so each enforces a share rather
# than a full budget. Default 4. This is a working assumption about the
# platform, not a guarantee it makes: set it too low and reviewers hit the cap,
# set it too high and the declared ceiling is optimistic. Correct it against
# what the deployment actually does.
# AGENT_ASSUMED_INSTANCES=4

# CEILING 3: per request. These bound what a single question can cost, which is
# what makes ceiling 2 multipliable into a dollar figure. An environment
# variable may only TIGHTEN them; a value above the code's own maximum is
# ignored rather than honoured, because these numbers are the unit cost the
# global ceiling is priced against.
#
# Tool loop steps. Default 8, hard maximum 12. Real answers use 3 to 6.
# AGENT_MAX_STEPS=8
# Characters of conversation history forwarded to the model, about 6,000
# tokens. Default and hard maximum 24000. History is resent on every step of
# the loop, so this is the largest input lever a caller controls.
# AGENT_MAX_TRANSCRIPT_CHARS=24000

# THE CEILING THAT ACTUALLY BINDS: the hard spend cap set on the key AT THE
# PROVIDER, in USD. Set the cap in the provider's dashboard first, then record
# the same number here. Nothing in this codebase can set it, and nothing here
# can verify it: this value is a declaration, and GET /api/agent reports it as
# one. What it changes in code is one thing, and it is deliberate: while it is
# unset and the server credential is billed, the global ceiling clamps to 100 a
# day and the route says why.
# AGENT_SPEND_CEILING_USD=25


# --- Logging ----------------------------------------------------------------
#
# One JSON line per agent event on stdout. Set to "off" to silence it. Log
# lines never contain key material: every message on the request path goes
# through lib/agent/redact.ts first, and the key itself is only ever logged as
# a non reversible fingerprint. tests/agent-secrets.test.ts enforces both.
# AGENT_LOG=off
#
# NODE_ENV is read alongside it and is set by the toolchain, not by you: the
# logger stays silent under "test" so a test run does not print agent events.


# --- Local tooling ------------------------------------------------------------
#
# Read by scripts and the test harness, never by the deployed app. Listed so
# that "every variable this repository reads" is one file rather than a grep.
#
# scripts/serve-artifacts.mjs, the local static server for published artifacts,
# so the UI can be pointed at a build before it is pinned:
# PUBLISH_DIR=../../data/artifacts/publish/duval
# ARTIFACT_PORT=8787
#
# playwright.config.ts. Set PLAYWRIGHT_BASE_URL to run the smoke suite against
# an already running server (a deployed URL included), in which case Playwright
# starts nothing itself. PLAYWRIGHT_PORT only applies when it does start one.
# CI is set by the runner and turns on retries and the HTML reporter.
# PLAYWRIGHT_BASE_URL=https://duval-oracle-ui.vercel.app
# PLAYWRIGHT_PORT=3123
