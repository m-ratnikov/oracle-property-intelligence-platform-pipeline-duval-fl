{
  "name": "duval-oracle-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Explorer UI for the Duval County FL property-intelligence dataset published on Elephant IPFS",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "assets": "node scripts/copy-duckdb.mjs",
    "sample": "node scripts/make-sample-data.mjs",
    "dev": "pnpm run assets && next dev",
    "build": "pnpm run assets && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.59",
    "@ai-sdk/anthropic": "^4.0.40",
    "@ai-sdk/cerebras": "^3.0.32",
    "@ai-sdk/gateway": "^4.0.56",
    "@ai-sdk/google": "^4.0.47",
    "@ai-sdk/groq": "^4.0.29",
    "@ai-sdk/openai": "^4.0.44",
    "@ai-sdk/openai-compatible": "^3.0.32",
    "@duckdb/duckdb-wasm": "^1.32.0",
    "@duckdb/node-api": "1.5.5-r.4",
    "ai": "^7.0.70",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.7",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.22.0"
}
