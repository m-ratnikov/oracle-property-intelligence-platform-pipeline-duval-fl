{
  "name": "duval-oracle-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Explorer UI for the Duval County FL property-intelligence dataset published on Elephant IPFS",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "assets": "node scripts/copy-duckdb.mjs",
    "sample": "node scripts/make-sample-data.mjs",
    "dev": "pnpm run assets && next dev",
    "build": "pnpm run assets && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.32.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@duckdb/node-api": "^1.5.5-r.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
