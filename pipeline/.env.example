# Where the DuckDB file, downloaded artifacts and publish outputs live.
# Defaults to ../data relative to the pipeline/ folder (outside the repo).
DATA_DIR=../data

# Filebase (S3-compatible pinning + IPNS). Leave empty for dry-run publish.
FILEBASE_ACCESS_KEY=
FILEBASE_SECRET_KEY=
# Bucket that holds every Duval artifact (query table, coverage, run history, entity tables, catalog)
FILEBASE_BUCKET_DUVAL=
# Optional overrides (defaults shown)
# FILEBASE_S3_ENDPOINT=https://s3.filebase.com
# FILEBASE_GATEWAY=https://ipfs.filebase.io

# Optional: override source URLs (defaults are the FDOR 2026P Duval files, see src/sources.ts)
# SOURCE_URL_NAL=
# SOURCE_URL_SDF=
# SOURCE_URL_PAR=

# Optional: cap the number of rows loaded from the PAR shapefile (local dev on a slow link)
# GEOMETRY_LIMIT=

# Optional: the two remaining source overrides (defaults in src/sources.ts)
# SOURCE_URL_GTFS=
# SOURCE_URL_OVERTURE=

# Sunbiz quarterly base snapshot. UNSET means off locally, ON when CI=true.
# This is the switch that turns `businesses` from a few thousand delta rows into the
# full Duval set, so a local run without it will not reproduce the published business
# counts. Downloads a 1.82 GB archive.
# SUNBIZ_BASE_SNAPSHOT=1
# SUNBIZ_BASE_MAX_ENTRIES=10      # cordata.zip members loaded per run; the archive has exactly 10
# SUNBIZ_KEEP_QUARTERLY_ZIP=1     # keep the zip instead of deleting it after extraction

# The one real permit number the JaxEPICS discovery step fetches, to find the Angular
# bundle and probe the API. Change it only if that permit is withdrawn.
# PERMITS_KNOWN=B-25-279425.000

# PA detail pages per run (also --window 300)
# PA_DETAIL_WINDOW=300

# Downgrade an unexpected NEW column in a source header from a run failure to a
# recorded limitation. Missing columns still fail the run either way.
# ALLOW_NEW_COLUMNS=1

# Minimum level for the structured JSON logs (src/log.ts). Default info.
# LOG_LEVEL=info

# Reconciling runs/ci-runs.json against the GitHub Actions API from outside a runner.
# Inside Actions the platform supplies GITHUB_TOKEN and GITHUB_WORKFLOW_REF instead.
# GH_TOKEN=
# CI_LEDGER_WORKFLOW_FILE=pipeline.yml

# Sunbiz SFTP (public credentials published at https://dos.fl.gov/sunbiz/other-services/data-downloads/)
SUNBIZ_HOST=sftp.floridados.gov
SUNBIZ_USER=Public
SUNBIZ_PASSWORD=PubAccess1845!
# SUNBIZ_WINDOW_DAYS=14           # daily files considered per run (also --window 14d)
# SUNBIZ_MAX_FILES_PER_RUN=30

# US-egress-only tracks (COJ / DBPR / JaxEPICS): tuning
# COJ_MAX_PAGES=                  # bound the paged pulls (dev)
# PERMITS_WINDOW=300              # permits enumerated per run (also --window 300)
# PERMITS_YEAR=26                 # B-YY- prefix year
# PERMITS_PREFIX=B
# PERMITS_START_SEQ=1             # first sequence when no cursor is journaled yet
