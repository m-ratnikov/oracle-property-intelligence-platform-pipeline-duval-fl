{
  "name": "@duval-oracle/pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Duval County (FL) Oracle ingestion pipeline: FDOR/COJ sources -> DuckDB -> Elephant IPFS artifacts",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "pipeline": "tsx src/cli.ts run",
    "features": "tsx src/cli.ts features",
    "validate": "tsx src/cli.ts validate",
    "publish:ipfs": "tsx src/cli.ts publish",
    "status": "tsx src/cli.ts status",
    "query": "tsx src/cli.ts query",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:consolidation": "tsx src/cli.ts consolidation",
    "publish:open-data": "tsx src/cli.ts publish-open-data",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@duckdb/node-api": "1.5.5-r.4",
    "adm-zip": "^0.5.16",
    "cheerio": "^1.2.0",
    "ipfs-only-hash": "^4.0.0",
    "multiformats": "^13.4.2",
    "ssh2-sftp-client": "^12.1.1",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@smithy/types": "^4.17.2",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.17.0",
    "@types/ssh2-sftp-client": "^9.0.6",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.22.0"
}
